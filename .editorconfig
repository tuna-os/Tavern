root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4

[*.blp]
indent_style = space
indent_size = 2

[meson.build]
indent_style = space
indent_size = 2

[*.xml]
indent_style = space
indent_size = 2

[{justfile,Justfile}]
indent_style = space
indent_size = 2

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
