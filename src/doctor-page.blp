using Gtk 4.0;
using Adw 1;

template $TavernDoctorPage: Adw.Bin {
  Box {
    orientation: vertical;
    hexpand: true;
    vexpand: true;

    /* Top Header Section */
    Box header_box {
      orientation: vertical;
      margin-start: 24;
      margin-end: 24;
      margin-top: 18;
      margin-bottom: 12;
      spacing: 10;

      Box {
        spacing: 12;

        Label {
          label: _("Brew Doctor");
          wrap: true;
          xalign: 0;
          hexpand: true;
          styles ["title-1"]
        }

        Gtk.Spinner spinner {}

        Button run_button {
          label: _("Run Check");
          valign: center;
          styles ["suggested-action"]
        }

        Button config_button {
          label: _("View Homebrew Configuration");
          valign: center;
        }

        Button copy_button {
          icon-name: "edit-copy-symbolic";
          tooltip-text: _("Copy Doctor Output");
          sensitive: false;
          valign: center;
          accessibility { label: _("Copy doctor output"); }
        }
      }

      Label {
        label: _("Check your Homebrew installation for common problems. This check does not run suggested fixes.");
        wrap: true;
        xalign: 0;
        styles ["dim-label"]
      }

      Label status_label {
        label: _("Ready to check");
        xalign: 0;
        wrap: true;
        styles ["heading"]
      }

      Label error_label {
        visible: false;
        xalign: 0;
        wrap: true;
        selectable: true;
        styles ["error"]
      }
    }

    Separator {
      orientation: horizontal;
    }

    /* Main Two-Column View taking full height */
    Box main_columns {
      orientation: horizontal;
      hexpand: true;
      vexpand: true;

      /* Left Sidebar: Findings List */
      Box sidebar_box {
        orientation: vertical;
        width-request: 280;
        hexpand: false;
        vexpand: true;

        ScrolledWindow {
          hscrollbar-policy: never;
          vexpand: true;

          Box {
            orientation: vertical;
            margin-start: 12;
            margin-end: 12;
            margin-top: 12;
            margin-bottom: 12;
            vexpand: true;

            ListBox findings_list {
              selection-mode: single;
              valign: start;
              styles ["boxed-list"]
            }
          }
        }
      }

      Separator sidebar_separator {
        orientation: vertical;
      }

      /* Right Pane: Issue Details taking full height */
      Box {
        orientation: vertical;
        hexpand: true;
        vexpand: true;

        ScrolledWindow {
          hscrollbar-policy: never;
          hexpand: true;
          vexpand: true;

          Adw.Clamp {
            maximum-size: 800;
            tightening-threshold: 680;
            margin-start: 24;
            margin-end: 24;
            margin-top: 20;
            margin-bottom: 24;
            vexpand: true;

            Box {
              orientation: vertical;
              spacing: 18;
              vexpand: true;

              /* Placeholder when nothing is selected */
              Label detail_placeholder {
                label: _("Select an issue to see its details");
                valign: center;
                halign: center;
                vexpand: true;
                wrap: true;
                justify: center;
                margin-top: 80;
                margin-bottom: 80;
                styles ["title-3", "dim-label"]
              }

              /* Content of the selected issue */
              Box detail_content {
                orientation: vertical;
                spacing: 16;
                visible: false;

                Box {
                  orientation: vertical;
                  spacing: 8;

                  Box {
                    orientation: horizontal;
                    spacing: 8;

                    Label detail_severity {
                      xalign: 0;
                      styles ["caption", "badge"]
                    }
                  }

                  Label detail_title {
                    xalign: 0;
                    wrap: true;
                    selectable: true;
                    styles ["title-2"]
                  }
                }

                Separator {
                  orientation: horizontal;
                }

                /* Container for parsed structured blocks */
                Box detail_blocks {
                  orientation: vertical;
                  spacing: 14;
                }

                /* Fallback body label for testing / plain issues without blocks */
                Label detail_body {
                  xalign: 0;
                  wrap: true;
                  selectable: true;
                  visible: false;
                }
              }

              /* Raw output expander at the bottom of the details scroll area */
              Expander raw_expander {
                label: _("Raw Output");
                visible: false;
                margin-top: 16;

                ScrolledWindow {
                  min-content-height: 200;

                  TextView raw_view {
                    editable: false;
                    cursor-visible: false;
                    monospace: true;
                    wrap-mode: word_char;
                    top-margin: 12;
                    bottom-margin: 12;
                    left-margin: 12;
                    right-margin: 12;
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
